legacy-peer-deps=false
fund=false
audit=false

# Do not put `script-shell` here.
#
# This file is committed and ships to EAS, whose builders are Ubuntu. A Windows
# shell path makes every dependency install there fail with:
#
#   npm error enoent spawn C:\Program Files\Git\bin\bash.exe ENOENT
#
# If a Windows machine needs bash as the script shell — this project's path
# contains "&", which cmd.exe treats as a command separator — set it per
# machine instead, where it never reaches the builder:
#
#   npm config set script-shell "C:\Program Files\Git\bin\bash.exe"
