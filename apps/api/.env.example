# Grab & Go API — environment
#
# Copy to `.env` and fill in. `apps/api/src/env.ts` validates every one of these
# at boot: the server refuses to start on a bad or missing value rather than
# failing later on a user's request.
#
# Never commit a filled-in .env.

# ----------------------------------------------------------------- runtime ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------- database ---
# docker compose up -d db  brings this up locally.
DATABASE_URL=postgresql://grabgo:grabgo@localhost:5432/grabgo?schema=public

# ------------------------------------------------------------------- auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters-please
# Separate key for pickup QR payloads, so a leaked QR key cannot mint sessions.
PICKUP_TOKEN_SECRET=replace-me-with-another-32-plus-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# ------------------------------------------------------------------- http ---
# Comma-separated. Must not be `*` in production.
CORS_ORIGINS=*
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind a single load
# balancer). 0 ignores X-Forwarded-For entirely. Too high lets clients spoof
# their IP past rate limits.
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ----------------------------------------------------------------- oauth ----
# Google: one client id per platform, all accepted as valid audiences.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
# Apple: the Services ID / bundle id the identity token is issued for.
APPLE_CLIENT_ID=

# ------------------------------------------------------------------- otp ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Development only: a fixed code so a simulator can sign in without SMS.
# The server refuses to boot in production if this is set.
OTP_DEV_CODE=000000

# ------------------------------------------------------------------- sms ----
# `mock` writes the OTP to the log instead of sending it.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --------------------------------------------------------------- payments ---
# `mock` settles instantly and is refused in production.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------ push ----
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# --------------------------------------------------------------- storage ----
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# ------------------------------------------------------------------ jobs ----
JOBS_ENABLED=true
JOB_INTERVAL_SECONDS=60

# Encrypts cafes' POS signing secrets at rest (AES-256-GCM). Required in
# production before any cafe can connect a POS; at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it makes existing POS secrets unreadable: cafes must generate new ones.
# POS_SECRET_KEY=
