{
  "name": "@grabgo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Grab & Go API: REST + realtime, Fastify, Prisma, PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@grabgo/config": "0.1.0",
    "@grabgo/core": "0.1.0",
    "@grabgo/types": "0.1.0",
    "@grabgo/validation": "0.1.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "expo-server-sdk": "^3.10.0",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
