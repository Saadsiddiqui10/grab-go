# Root environment reference.
#
# Each app owns its own .env; this file is the map of which is which.
#
#   apps/api/.env.example                 the server (database, secrets, providers)
#   apps/merchant-dashboard/.env.example  cafe dashboard
#   apps/admin-dashboard/.env.example     admin dashboard
#   apps/mobile/.env.example              Expo app
#
# Copy each .env.example to .env next to it and fill in the values.
# Never commit a filled-in .env.

# The only variable the root scripts read directly. Prisma CLI commands run
# from apps/api and use apps/api/.env.
DATABASE_URL=postgresql://grabgo:grabgo@localhost:5432/grabgo?schema=public
